PORT=4173
HOST=127.0.0.1
BASE_URL=http://127.0.0.1:4173
# Local work: demo + sqlite. Public hosting: preview or production + mysql.
APP_MODE=demo
DB_DRIVER=sqlite
DB_PATH=./data/astra.sqlite
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Optional CA file for a remote database with verified TLS:
MYSQL_SSL_CA=
CODE_REVISION=
# Set these on the server, never in GitHub:
ADMIN_EMAIL=
ADMIN_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
DISCORD_INVITE_URL=
# Real payment mode requires seller details and explicit activation:
LIVE_PAYMENTS_ENABLED=false
SELLER_NAME=
SELLER_ADDRESS=
SELLER_CODE=
